FROM node:22-bookworm AS frontend-builder
WORKDIR /src/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./
RUN npm run build

FROM golang:1.24-bookworm AS backend-builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . ./
COPY --from=frontend-builder /src/frontend/dist ./frontend/dist

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -tags web -trimpath -ldflags="-s -w" -o /out/cpa-control-center-web .

FROM lwthiker/curl-impersonate:latest AS curl-impersonate

FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV CPA_CONTROL_CENTER_LISTEN=:8080
ENV CPA_CONTROL_CENTER_DATA_DIR=/data

WORKDIR /app
VOLUME ["/data"]
EXPOSE 8080

COPY --from=backend-builder /out/cpa-control-center-web /usr/local/bin/cpa-control-center-web
COPY --from=curl-impersonate /build/out/curl-impersonate-ff /usr/local/bin/curl-impersonate-ff
COPY --from=curl-impersonate /build/out/curl_ff117 /usr/local/bin/curl_ff117
COPY internal/backend/openai_sentinel_token.js /app/openai_sentinel_token.js

CMD ["cpa-control-center-web"]
